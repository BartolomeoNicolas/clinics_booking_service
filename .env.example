# clinics_booking_service · variables de configuración y secretos
#
# Copiar a `.env` en la raíz del repo y completar. `.env` está en .gitignore: NUNCA se versiona.
#
#   cp .env.example .env && chmod 600 .env
#
# Alternativa: usar ~/.config/clinics/secrets/booking.yml (por defecto) en vez de `.env`.
# Ver "Dónde poner los secretos" más abajo.

# ---------------------------------------------------------------------------
# Base de datos local (PostgreSQL 16). Requerida: la app no arranca sin ella.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=clinics_booking
DB_USER=booking_app
DB_PASSWORD=

# Puerto host donde se publica Postgres. 5432 del host lo ocupa peer-guard-compII.
DB_PORT=55433

# ---------------------------------------------------------------------------
# Redis. Requerida para el lock distribuido y el diagnostico de reservas.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Par RSA de firma de los JWT de sesión.
#
# La privada se queda en esta máquina: sale de acá hacia el servicio de catálogo
# únicamente la pública. Si no existen, el servicio las genera en el primer
# arranque; para rotarlas, poné CLINICS_JWT_ROTATE=true una vez.
# ---------------------------------------------------------------------------
CLINICS_JWT_PRIVATE_KEY_PATH=
CLINICS_JWT_PUBLIC_KEY_PATH=
# La MISMA audiencia que usa clinics_sync_service: la app KMP consume las dos
# APIs con un solo token de sesión.
CLINICS_JWT_AUDIENCE=clinics
CLINICS_JWT_ISSUER=clinics-booking
CLINICS_JWT_ROTATE=false
CLINICS_JWT_KEY_SIZE=2048

# ---------------------------------------------------------------------------
# Cuenta técnica de la cátedra (POST /api/authenticate).
#
# La MISMA cuenta que usa clinics_sync_service: los dos servicios hablan con la
# catedra presentando el mismo JWT técnico, y ninguna de esas credenciales cruza
# nunca hacia la app KMP.
#
# No son obligatorias al arrancar: la cuenta se da de alta una sola vez y un
# servicio sin credenciales tiene que poder levantar. Si faltan cuando se usan,
# el error nombra la variable que falta.
#
# Mismos nombres de variable que en clinics_sync_service, para poder compartir
# el mismo .env entre los dos repos.
# ---------------------------------------------------------------------------
CATEDRA_BASE_URL=http://172.17.201.1:8090
CATEDRA_TECHNICAL_USER=
CATEDRA_TECHNICAL_PASSWORD=
# JWT entregado al registrar la cuenta. Opcional: si está y alcanza ahorra un
# login; si venció, el servicio pide uno nuevo y el renovado queda en memoria.
CATEDRA_TECHNICAL_JWT=
# Timeouts por operación (milisegundos) y reintentos de LECTURA. Las escrituras
# nunca se reintentan solas: un timeout no prueba que hayan fallado.
CATEDRA_CONNECT_TIMEOUT_MS=2000
CATEDRA_OCCUPANCIES_READ_TIMEOUT_MS=3000
CATEDRA_APPOINTMENTS_READ_TIMEOUT_MS=5000
CATEDRA_CREATE_HOLD_TIMEOUT_MS=5000
CATEDRA_CONFIRM_HOLD_TIMEOUT_MS=8000
CATEDRA_CANCEL_TIMEOUT_MS=5000
CATEDRA_READ_RETRIES=2

# ---------------------------------------------------------------------------
# Desarrollo local.
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Dónde poner los secretos
#
# 1. `.env` en la raíz del repo — cómodo para desarrollo, ignorado por git.
#      cp .env.example .env && chmod 600 .env
#
# 2. `~/.config/clinics/secrets/booking.yml` — ubicación canónica, fuera del repo.
#    Es la que el compose y los dos backends leen por defecto.
#
# El archivo de secretos tiene esta forma:
#
#   clinics:
#     local:
#       db-password: "..."
#     security:
#       jwt:
#         private-key-path: /home/<usuario>/.config/clinics/secrets/jwt-private.pem
#         public-key-path: /home/<usuario>/.config/clinics/secrets/jwt-public.pem
#
# Y los valores compartidos con clinics_sync_service van en `common.yml`:
#
#   clinics:
#     security:
#       jwt:
#         audience: clinics
# ---------------------------------------------------------------------------